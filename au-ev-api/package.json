{
  "name": "au-ev-catalog-api",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API aggregating Australian EV specifications, feature options, and novated lease scoring",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "build:catalog": "node src/catalog/build.js",
    "scrape": "node src/au_ev_scraper_pipeline.js",
    "scrape:dry": "node src/au_ev_scraper_pipeline.js --dry-run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0"
  }
}